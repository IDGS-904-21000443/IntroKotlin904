<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp"
    android:gravity="center"
    tools:context=".diccionario.Ventana3Activity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar palabras"
        android:textSize="25sp"
        android:gravity="center"/>

    <RadioGroup
        android:id="@+id/rdgPalabras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:gravity="center"
        >
        <RadioButton
            android:id="@+id/rdbEspanol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Español"
            android:checked="true"
            android:layout_marginEnd="20dp"
            />

        <RadioButton
            android:id="@+id/rdbIngles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inglés"
            android:checked="false"
            />
    </RadioGroup>

    <EditText
        android:id="@+id/txtBuscarPal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="Escribe la palabra a buscar"
        android:textSize="25sp"
        />

    <Button
        android:id="@+id/btnBuscarPal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar"
        android:layout_marginTop="15dp"
        />

    <TextView
        android:id="@+id/txtBuscarRes"
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:text="Resultado: "
        android:textSize="25sp"
        android:layout_marginTop="15dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnRegresar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Regresar"
        android:layout_marginTop="15dp"
        />

</LinearLayout>